<odoo>
  <data>
    <record id="partner_view_form_chinese_zodiac" model="ir.ui.view">
      <field name="name">res.partner.chinese.zodiac.form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
            <page string = "Signo chino">
                    <group>
                        <field name="f_nac" string = "Fecha de nacimiento"/>
                        <field name="edad"  string= "Edad"/>
                        <field name="signo_chino" string="Signo del horoscopo chino"/>
                    </group>
            </page>
        </xpath>
      </field>
    </record>

    <record id="partner_view_tree_chinese_zodiac" model="ir.ui.view">
      <field name="name">partner_chinese_stats_tree</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='complete_name']" position="after">
            <field name="signo_chino" string = "Signo del horoscopo chino"/>
        </xpath>
      </field>
    </record>
    <record id="partner_view_kanban_chinese_zodiac" model="ir.ui.view">
      <field name="name">partner_chinese_stats_kanban</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.res_partner_kanban_view"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='display_name']" position="after">
            <field name="signo_chino"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>