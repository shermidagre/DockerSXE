<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <template id="listing" name="Listado de Alumnos y Sueño">
          <ul>
            <li t-foreach="objects" t-as="object">
              <a t-attf-href="#{ root }/objects/#{ object.id }">
                <t t-esc="object.alumno"/> (Nivel de Sueño: <t t-esc="object.nivel_sueno"/>)
              </a>
            </li>
          </ul>
        </template>

        <template id="object" name="Detalle de Nivel de Sueño">
          <h1><t t-esc="object.alumno"/></h1>
          <dl>
            <dt>Nivel de Sueño:</dt>
            <dd><t t-esc="object.nivel_sueno"/></dd>

            <dt>Bebida Recomendada:</dt>
            <dd><strong><t t-esc="object.bebida_recomendada"/></strong></dd>

            <dt>Notas:</dt>
            <dd><t t-esc="object.description"/></dd>
          </dl>
        </template>
    </data>
</odoo>