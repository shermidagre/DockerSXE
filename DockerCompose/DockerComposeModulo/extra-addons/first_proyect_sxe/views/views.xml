<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="first_proyect_sxe.list">
      <field name="name">firstProyectSXE list</field>
      <field name="model">first_proyect_sxe.first_proyect_sxe</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </list>
      </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="first_proyect_sxe.action_window">
      <field name="name">firstProyectSXE window</field>
      <field name="res_model">first_proyect_sxe.first_proyect_sxe</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- server action to the one above -->

    <record model="ir.actions.server" id="first_proyect_sxe.action_server">
      <field name="name">firstProyectSXE server</field>
      <field name="model_id" ref="model_first_proyect_sxe_first_proyect_sxe"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>

    <!-- Top menu item -->

    <menuitem name="firstProyectSXE" id="first_proyect_sxe.menu_root"/>

    <!-- menu categories -->

    <menuitem name="Menu 1" id="first_proyect_sxe.menu_1" parent="first_proyect_sxe.menu_root"/>
    <menuitem name="Menu 2" id="first_proyect_sxe.menu_2" parent="first_proyect_sxe.menu_root"/>

    <!-- actions -->

    <menuitem name="List" id="first_proyect_sxe.menu_1_list" parent="first_proyect_sxe.menu_1"
              action="first_proyect_sxe.action_window"/>
    <menuitem name="Server to list" id="first_proyect_sxe" parent="first_proyect_sxe.menu_2"
              action="first_proyect_sxe.action_server"/>

  </data>
</odoo>
