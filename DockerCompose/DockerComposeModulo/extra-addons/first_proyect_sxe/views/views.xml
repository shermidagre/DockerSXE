<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record model="ir.ui.view" id="first_proyect_sxe.form">
      <field name="name">Nivel de Sueño Form</field>
      <field name="model">first_proyect_sxe.first_proyect_sxe</field>
      <field name="arch" type="xml">
        <form string="Registro de Sueño del Alumno">
          <sheet>
            <group>
              <field name="alumno"/> <field name="nivel_sueño"/> <field name="bebida_recomendada" readonly="1"/> </group>
          </sheet>
        </form>
      </field>
    </record>

      <record id="first_proyect_sxe.search" model="ir.ui.view">
      <field name="name">Nivel de Sueño Search</field>
      <field name="model">first_proyect_sxe.first_proyect_sxe</field>
      <field name="arch" type="xml">
        <search string="Buscar Registros de Sueño">
          <field name="alumno"/>
          <field name="nivel_sueño"/>

          <filter string="Alerta de Sueño (Nivel 10)" name="nivel_10" domain="[('nivel_sueno', '=', 10)]"/>

          <group expand="0" string="Agrupar Por">
            <filter string="Alumno" name="group_by_alumno" context="{'group_by':'alumno'}"/>
            <filter string="Fecha" name="group_by_fecha" context="{'group_by':'fecha_registro:day'}"/>
          </group>
        </search>
      </field>
    </record>



    <record model="ir.ui.view" id="first_proyect_sxe.list">
      <field name="name">firstProyectSXE list</field>
      <field name="model">first_proyect_sxe.first_proyect_sxe</field>
      <field name="arch" type="xml">
        <list>
            <field name="alumno"/>
            <field name="fecha_registro" optional="show"/>
            <field name="nivel_sueño"/>
            <field name="bebida_recomendada"
                 decoration-info="nivel_sueño &lt; 4"
                 decoration-warning="nivel_sueño &gt;= 4 and nivel_sueño &lt; 7"
                 decoration-danger="nivel_sueño &gt;= 7"/>
        </list>
      </field>
    </record>

    <record model="ir.actions.act_window" id="first_proyect_sxe.action_window">
        <field name="view_mode">form</field>
        <field name="name">Control de Sueño del Alumnado</field>
       <field name="res_model">first_proyect_sxe.first_proyect_sxe</field>
    </record>

    <record model="ir.actions.server" id="first_proyect_sxe.action_server">
      <field name="name">firstProyectSXE server</field>
      <field name="model_id" ref="model_first_proyect_sxe_first_proyect_sxe"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>

    <menuitem name="Control de Sueño SXE" id="first_proyect_sxe.menu_root"/>

    <menuitem name="Registrar Sueño" id="first_proyect_sxe.menu_1" parent="first_proyect_sxe.menu_root"/>

    <menuitem name="Alumnos y Bebidas" id="first_proyect_sxe.menu_1_list" parent="first_proyect_sxe.menu_1"
              action="first_proyect_sxe.action_window"/>

    </data>
</odoo>